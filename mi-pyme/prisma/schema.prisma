generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  name                  String?
  username              String?              @unique
  email                 String               @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  nombre                String?
  rol                   Rol                  @default(CLIENTE)
  provincia             String?
  municipio             String?
  isGenericAdmin        Boolean              @default(false)
  mustChangePassword    Boolean              @default(false)
  isActive              Boolean              @default(true)
  deletedAt             DateTime?
  deletedBy             String?
  deletedReason         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  accounts              Account[]
  carritos              Carrito[]
  facturas              Factura[]
  negocios              Negocio[]
  pedidos               Pedido[]
  proveedoresLogisticos ProveedorLogistico[]
  reservas              Reserva[]
  sessions              Session[]
  auditLogs             AuditLog[]

  @@index([rol])
  @@index([isGenericAdmin])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Negocio {
  id                 String            @id @default(cuid())
  nombre             String
  descripcion        String?
  slug               String            @unique
  activo             Boolean           @default(true)
  areaId             String?
  userId             String?
  permiteReservas    Boolean           @default(true)
  permiteEnvio       Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  facturas           Factura[]
  area               Area?             @relation(fields: [areaId], references: [id])
  user               User?             @relation(fields: [userId], references: [id])
  subareas           NegocioSubarea[]
  opcionesLogisticas OpcionLogistica[]
  pedidosItems       PedidoItem[]
  productos          Producto[]
  reportesVentas     ReporteVenta[]
  reservas           Reserva[]
  servicios          Servicio[]
}

model Area {
  id        String    @id @default(cuid())
  nombre    String
  slug      String    @unique
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  negocios  Negocio[]
  subareas  Subarea[]
}

model Subarea {
  id        String           @id @default(cuid())
  nombre    String
  slug      String           @unique
  activo    Boolean          @default(true)
  areaId    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  negocios  NegocioSubarea[]
  productos Producto[]
  servicios Servicio[]
  area      Area?            @relation(fields: [areaId], references: [id])
}

model NegocioSubarea {
  id        String  @id @default(cuid())
  negocioId String
  subareaId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  subarea   Subarea @relation(fields: [subareaId], references: [id], onDelete: Cascade)

  @@unique([negocioId, subareaId])
}

model Producto {
  id            String        @id @default(cuid())
  negocioId     String
  subareaId     String
  nombre        String
  descripcion   String?
  precio        Float
  unidadMedida  String
  imagenUrl     String
  disponibleHoy Boolean       @default(true)
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  carritoItems  CarritoItem[]
  facturaItems  FacturaItem[]
  inventario    Inventario[]
  pedidoItems   PedidoItem[]
  negocio       Negocio       @relation(fields: [negocioId], references: [id])
  subarea       Subarea       @relation(fields: [subareaId], references: [id])
}

model Servicio {
  id                  String        @id @default(cuid())
  negocioId           String
  subareaId           String
  nombre              String
  descripcion         String?
  duracionMinutos     Int
  horariosDisponibles Json
  capacidad           Int
  imagenUrl           String
  activo              Boolean       @default(true)
  permiteReservas     Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  carritoItems        CarritoItem[]
  facturaItems        FacturaItem[]
  pedidoItems         PedidoItem[]
  reservas            Reserva[]
  negocio             Negocio       @relation(fields: [negocioId], references: [id])
  subarea             Subarea       @relation(fields: [subareaId], references: [id])
}

model Inventario {
  id             String   @id @default(cuid())
  productoId     String
  cantidadActual Int
  puntoReorden   Int
  ubicacion      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Carrito {
  id            String        @id @default(cuid())
  usuarioId     String
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
  estado        String        @default("activo")
  usuario       User          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items         CarritoItem[]

  @@unique([usuarioId, estado])
}

model CarritoItem {
  id             String    @id @default(cuid())
  carritoId      String
  productoId     String?
  servicioId     String?
  cantidad       Int
  precioUnitario Float
  tipo           String
  carrito        Carrito   @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto       Producto? @relation(fields: [productoId], references: [id])
  servicio       Servicio? @relation(fields: [servicioId], references: [id])
}

model Reserva {
  id              String   @id @default(cuid())
  usuarioId       String
  servicioId      String
  negocioId       String
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  venceEn         DateTime
  estado          String   @default("pendiente")
  usuario         User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  servicio        Servicio @relation(fields: [servicioId], references: [id])
  negocio         Negocio  @relation(fields: [negocioId], references: [id])
}

model ProveedorLogistico {
  id            String            @id @default(cuid())
  usuarioId     String
  nombre        String
  zonaCobertura String
  contacto      String
  activo        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  opciones      OpcionLogistica[]
  usuario       User              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model OpcionLogistica {
  id                 String             @id @default(cuid())
  negocioId          String
  proveedorId        String
  nombre             String
  tipo               String
  tarifaBase         Float
  tarifaPorDistancia Float
  tiempoEstimado     String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  proveedor          ProveedorLogistico @relation(fields: [proveedorId], references: [id])
  negocio            Negocio            @relation(fields: [negocioId], references: [id])
  pedidos            Pedido[]
}

model Pedido {
  id               String           @id @default(cuid())
  usuarioId        String
  total            Float
  estado           String           @default("pendiente")
  tipo             String
  negocioIds       Json
  logisticaId      String?
  direccionEntrega String
  fechaCreacion    DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  factura          Factura?
  logistica        OpcionLogistica? @relation(fields: [logisticaId], references: [id])
  usuario          User             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items            PedidoItem[]
}

model PedidoItem {
  id             String    @id @default(cuid())
  pedidoId       String
  productoId     String?
  servicioId     String?
  cantidad       Int
  precioUnitario Float
  subtotal       Float
  negocioId      String
  negocio        Negocio   @relation(fields: [negocioId], references: [id])
  servicio       Servicio? @relation(fields: [servicioId], references: [id])
  producto       Producto? @relation(fields: [productoId], references: [id])
  pedido         Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model Factura {
  id        String        @id @default(cuid())
  pedidoId  String        @unique
  usuarioId String
  negocioId String?
  numero    String        @unique
  fecha     DateTime      @default(now())
  estado    String        @default("emitida")
  subtotal  Float
  impuestos Float         @default(0)
  total     Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  pedido    Pedido        @relation(fields: [pedidoId], references: [id])
  negocio   Negocio?      @relation(fields: [negocioId], references: [id])
  usuario   User          @relation(fields: [usuarioId], references: [id])
  items     FacturaItem[]
}

model FacturaItem {
  id             String    @id @default(cuid())
  facturaId      String
  productoId     String?
  servicioId     String?
  cantidad       Int
  precioUnitario Float
  subtotal       Float
  servicio       Servicio? @relation(fields: [servicioId], references: [id])
  producto       Producto? @relation(fields: [productoId], references: [id])
  factura        Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
}

model ReporteVenta {
  id              String   @id @default(cuid())
  negocioId       String
  fecha           DateTime @default(now())
  totalVentas     Float
  cantidadPedidos Int
  negocio         Negocio  @relation(fields: [negocioId], references: [id])
}

enum Rol {
  ADMIN
  CLIENTE
  NEGOCIO
  LOGISTICA
}

model AuditLog {
  id          String   @id @default(cuid())
  eventType   String
  actorId     String?
  targetId    String?
  timestamp   DateTime @default(now())
  meta        Json?
  user        User?    @relation(fields: [actorId], references: [id])

  @@index([eventType])
  @@index([actorId])
  @@index([targetId])
  @@index([timestamp])
}
