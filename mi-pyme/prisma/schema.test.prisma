/// Tipos de evento notificable
enum TipoNotificacion {
  PEDIDO_CREADO
  PEDIDO_ESTADO_CAMBIADO
  PEDIDO_ASIGNADO_LOGISTICA
  RESERVA_CREADA
  RESERVA_CANCELADA
  PAGO_COMPROBANTE_SUBIDO
  PAGO_CONFIRMADO
  PAGO_RECHAZADO
  PAGO_REEMBOLSADO
  CODIGO_ENTREGA_REGENERADO
  SOLICITUD_ALTA_CREADA
  SOLICITUD_ALTA_APROBADA
  SOLICITUD_ALTA_RECHAZADA
  DISPONIBILIDAD_AGOTADA
  STOCK_BAJO
  TRANSPORTE_CONTRATADO
  CUPON_PROXIMO_A_EXPIRAR
  PROMOCION_AGOTADA
  BIENVENIDA
  PASSWORD_CAMBIADO
  LOGIN_NUEVO_DISPOSITIVO
}

/// Estados de una notificación
enum EstadoNotificacion {
  NO_LEIDA
  LEIDA
  ARCHIVADA
}

/// Canales de notificación
enum CanalNotificacion {
  IN_APP
  EMAIL
}

/// Notificación multicanal para usuarios (in-app + email)
model Notificacion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo          TipoNotificacion
  estado        EstadoNotificacion @default(NO_LEIDA)
  titulo        String
  mensaje       String
  enlace        String?
  metadata      Json?
  leidaEn       DateTime?
  emailEnviado  Boolean  @default(false)
  emailEnviadoEn DateTime?
  emailError    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, estado])
  @@index([userId, createdAt])
  @@index([tipo])
}

/// Preferencias de notificación por usuario y tipo de evento
model PreferenciaNotificacion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacion
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tipo])
  @@index([userId])
}
