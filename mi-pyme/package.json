{
  "name": "mi-pyme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test visual-tests/accessibility.test.mjs -c playwright.a11y.config.mjs",
    "test:visual": "playwright test visual-tests/components.visual.test.mjs -c playwright.visual.config.mjs",
    "test:visual:comprehensive": "playwright test visual-tests/comprehensive.visual.test.mjs -c playwright.visual.config.mjs",
    "test:visual:all": "npm run test:a11y && npm run test:visual:comprehensive",
    "test:lighthouse": "lhci autorun",
    "test:e2e": "node --import tsx playwright test e2e/ -c playwright.e2e.config.mjs",

    "test:reports": "tsx scripts/generate-reports.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "postinstall": "prisma skills sync || exit 0",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:disp": "tsx scripts/seed-disponibilidad.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^0.5.2-next.19",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "node-cache": "^5.1.2",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-essentials": "^9.0.0-alpha.12",
    "@storybook/addon-interactions": "^9.0.0-alpha.10",
    "@storybook/addon-links": "^11.0.0-alpha.0",
    "@storybook/addon-themes": "^11.0.0-alpha.0",
    "@storybook/blocks": "^9.0.0-alpha.17",
    "@storybook/nextjs": "^11.0.0-alpha.0",
    "@storybook/react": "^11.0.0-alpha.0",
    "@storybook/test": "^9.0.0-alpha.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-cache": "^4.1.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "storybook": "^11.0.0-alpha.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
